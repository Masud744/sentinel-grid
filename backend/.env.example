PROJECT_NAME="Smart Campus Safety & Response Grid (SCS-RG)"
API_V1_STR="/api/v1"
SECRET_KEY="scs-rg-super-secret-jwt-key-for-robo-fusion-competition"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (Supabase PostgreSQL example)
# DATABASE_URL="postgresql+asyncpg://postgres.xxxx:yyyy@aws-0-us-east-1.pooler.supabase.com:6543/postgres"
# SYNC_DATABASE_URL="postgresql://postgres.xxxx:yyyy@aws-0-us-east-1.pooler.supabase.com:6543/postgres"
DATABASE_URL="sqlite+aiosqlite:///./scs_rg.db"
SYNC_DATABASE_URL="sqlite:///./scs_rg.db"

# Feature Flags
BONUS_TREND_ENABLED=true
